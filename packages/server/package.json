{
  "name": "crv-review",
  "version": "0.1.0",
  "description": "面对面 Code Review 会议工具：双分支对比、双模式 diff、行级评论、导出纪要、跳转定义",
  "license": "MIT",
  "bin": {
    "crv": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": ["dist", "web-dist"],
  "keywords": ["code-review", "git", "diff", "meeting", "cli"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "prepack": "node scripts/pack-web.cjs"
  },
  "dependencies": {
    "@fastify/static": "^8.1.0",
    "diff": "^7.0.0",
    "fastify": "^5.3.0",
    "open": "^10.1.0",
    "simple-git": "^3.27.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.27.0",
    "write-file-atomic": "^4.0.2"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/node": "^22.15.0",
    "@types/write-file-atomic": "^4.0.4",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.0"
  }
}
